# AeroDataBox (RapidAPI) key for flight lookup.
#
# WARNING: anything prefixed EXPO_PUBLIC_ is inlined into the JavaScript bundle
# at build time. It is readable by anyone who downloads the app. This is fine
# for development, but before release the lookup must move behind a small
# server that holds the key, or the quota is everyone's to spend.
EXPO_PUBLIC_AERODATABOX_KEY=your-rapidapi-key
